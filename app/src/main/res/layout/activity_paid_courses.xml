<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cv_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="90dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageButton
                    android:id="@+id/paidBack"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_back"
                    android:padding="12dp"
                    android:contentDescription="@string/back_description"
                    app:tint="@color/cv_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cyberverse_dot"
                    style="@style/LogoText"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <include layout="@layout/view_search"/>

            <TextView
                android:id="@+id/paidCourseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_paid_courses"
                style="@style/SectionTitle"
                android:layout_marginStart="20dp"
                android:layout_marginTop="25dp"/>

            <TextView
                android:layout_width="75dp"
                android:layout_height="31dp"
                android:text="@string/category_all"
                android:gravity="center"
                android:background="@drawable/bg_purple"
                style="@style/PurpleButtonText"
                android:layout_marginStart="20dp"
                android:layout_marginTop="27dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp">

                <include
                    android:id="@+id/itemCourseSkillLogic"
                    layout="@layout/item_course_skilllogic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"/>
                <include
                    android:id="@+id/itemCourseISC2"
                    layout="@layout/item_course_isc2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"/>
                <include
                    android:id="@+id/itemCourseSkillLogic2"
                    layout="@layout/item_course_skilllogic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"/>
                <include
                    android:id="@+id/itemCourseISC2_2"
                    layout="@layout/item_course_isc2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"/>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"/>

    <FrameLayout
        android:id="@+id/kittyFab"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="208dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_circle_purple">

        <ImageView
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cat"
            app:tint="@color/cv_white"
            android:contentDescription="@string/cyberkitty_description"/>
    </FrameLayout>
</FrameLayout>
