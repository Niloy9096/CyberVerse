<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cv_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/profileBack"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_back"
                    android:padding="12dp"
                    android:contentDescription="@string/back_description"
                    app:tint="@color/cv_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cyberverse_dot"
                    style="@style/LogoText"
                    android:layout_gravity="center"
                    android:layout_marginTop="0dp"/>
            </FrameLayout>

            <!-- Guest State Container (Visible by default) -->
            <LinearLayout
                android:id="@+id/guestContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="60dp"
                android:background="@drawable/bg_large_card"
                android:padding="30dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/cv_primary_light"
                    android:contentDescription="@string/title_profile"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_guest_msg"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/cv_text_secondary"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:id="@+id/gotoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/action_login"
                    android:gravity="center"
                    android:background="@drawable/bg_purple"
                    style="@style/PurpleButtonText"
                    android:layout_marginTop="30dp"/>

                <TextView
                    android:id="@+id/gotoSignup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/action_signup"
                    android:gravity="center"
                    android:textColor="@color/cv_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- User State Container (Hidden by default) -->
            <LinearLayout
                android:id="@+id/userContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="60dp"
                android:background="@drawable/bg_large_card"
                android:padding="30dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/cv_primary"
                    android:contentDescription="@string/title_profile"/>

                <TextView
                    android:id="@+id/profileUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_username"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_primary"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_email_dummy"
                    android:textSize="14sp"
                    android:textColor="@color/cv_text_light"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cv_border"
                    android:layout_marginTop="30dp"/>

                <TextView
                    android:id="@+id/logoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/action_logout"
                    android:gravity="center"
                    android:textColor="#FF4444"
                    android:textStyle="bold"
                    android:layout_marginTop="30dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"/>

</FrameLayout>
