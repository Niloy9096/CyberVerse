<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cv_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_large_card">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <ImageButton
                    android:id="@+id/detailBack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/back_description"/>

                <TextView
                    android:id="@+id/detailHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_certification"
                    style="@style/PageTitle"
                    android:textSize="24sp"
                    android:gravity="center"/>
            </FrameLayout>

            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:src="@drawable/certificate"
                android:scaleType="centerInside"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/title_certification"/>

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_title_advanced"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/detailProvider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/course_provider_great_learning"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_description_advanced"
                android:textSize="12sp"
                android:textColor="@color/cv_text_light"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_stats_advanced"
                android:textSize="12sp"
                android:textColor="@color/cv_primary"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/takeExam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/action_take_exam"
                    android:gravity="center"
                    android:background="@drawable/bg_purple"
                    style="@style/PurpleButtonText"/>

                <Space
                    android:layout_width="28dp"
                    android:layout_height="1dp"/>

                <TextView
                    android:id="@+id/learnMore"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/action_learn_more"
                    android:gravity="center"
                    android:background="@drawable/bg_purple"
                    style="@style/PurpleButtonText"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"/>
</FrameLayout>
